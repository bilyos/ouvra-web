    "faq": {
      "title": "Frequent questions",
      "contact": "Another question? Message us on WhatsApp, we reply during the day.",
      "contactCta": "Message us on WhatsApp",
      "items": {
        "how": {
          "question": "How does Ouvra work?",
          "answer": "Search for a trade in your city, compare profiles (reviews, prices, availability), then message the provider or book directly. Payment and review happen on the platform afterwards."
        },
        "free": {
          "question": "Is signing up free?",
          "answer": "Yes, for clients and providers alike. Providers can take a subscription to be featured more, but it is optional."
        },
        "verification": {
          "question": "How are providers verified?",
          "answer": "Our team checks the ID document, phone number and two job references before a profile goes live. Client reviews take over from there."
        },
        "payment": {
          "question": "Which payment methods are accepted?",
          "answer": "Orange Money, MTN Mobile Money, Visa and Mastercard. You get a receipt after every payment."
        },
        "problem": {
          "question": "What if something goes wrong with a provider?",
          "answer": "Report it from the booking page. Support answers 7 days a week and can suspend a profile while the case is reviewed."
        },
        "cities": {
          "question": "Which cities do you cover?",
          "answer": "Douala and Yaoundé have the most providers. Bafoussam, Bamenda, Garoua, Kribi and the other regional capitals follow, with new sign-ups every week."
        },
        "becomeProvider": {
          "question": "How do I become a provider?",
          "answer": "Create an account as a “Provider”, describe your work and starting price, then send your documents. Your profile goes live once verified."
        }
      }
    },
